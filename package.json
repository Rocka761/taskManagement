{
  "name": "backendfullstack",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "start": "forever start app.json",
    "server": "forever restartall",
    "stop": "forever stopall",
    "build": "npm-run-all clean transpile copy-assets",
    "purge": "rimraf --glob logs/*",
    "clean": "rimraf dist",
    "transpile": "babel src -d dist",
    "copy-assets": "cpx \"src/**/*.{html,css,scss,hbs,json}\" dist",
    "dev": "npm-run-all stop purge build start",
    "watch": "nodemon"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "nodemonConfig": {
    "exec": "npm run dev",
    "watch": [
      "src/*"
    ],
    "ignore": [
      "**/__tests__/**",
      "*.test.js",
      "*.spec.js"
    ]
  },
  "babel": {
    "presets": [
      "@babel/preset-env"
    ],
    "plugins": [
      [
        "@babel/transform-runtime"
      ],
      [
        "@babel/plugin-transform-class-properties"
      ],
      [
        "@babel/plugin-transform-object-rest-spread"
      ]
    ]
  },
  "description": "",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "js-sha256": "^0.11.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.14.1",
    "sequelize": "^6.37.7",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.27.2",
    "@babel/core": "^7.27.1",
    "@babel/plugin-transform-class-properties": "^7.23.3",
    "@babel/plugin-transform-object-rest-spread": "^7.23.4",
    "@babel/plugin-transform-runtime": "^7.23.9",
    "@babel/preset-env": "^7.27.2",
    "@babel/runtime": "^7.23.9",
    "@jest/globals": "^30.0.0-beta.3",
    "cpx": "^1.5.0",
    "forever": "^4.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.1"
  }
}
